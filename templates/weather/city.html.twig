{% extends 'base.html.twig' %}

{% block title %}Weather in {{ location.city }}, {{ location.country }}{% endblock %}

{% block body %}
    <div style="padding: 20px; font-family: Arial, sans-serif;">
        <h1>Weather in {{ location.city }}, {{ location.country }}</h1>

        <ul>
            {% for measurement in location.measurements %}
                <li>{{ measurement.date|date('d.m.Y') }}: {{ measurement.celsius }}°C</li>
            {% endfor %}
        </ul>
    </div>
{% endblock %}
